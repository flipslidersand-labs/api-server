# =============================================================
# api-server 環境変数テンプレート
# cp .env.example .env  して実際の値を設定してください
# .env は .gitignore で除外済み — コミット禁止
# =============================================================

# サーバー
PORT=3000

# Supabase（Render の場合はダッシュボードで設定）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# JWT (HS256 モード — 通常はこちらを使用)
JWT_SECRET=change-me-to-a-long-random-string-32chars-min
JWT_REFRESH_SECRET=change-me-to-another-long-random-string

# JWT (RS256 モード — HS256 を使う場合は不要)
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
